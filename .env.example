# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewelup

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=your-session-secret-change-this

# Silver Rate API
SILVER_RATE_API_KEY=your-metal-price-api-key
SILVER_RATE_API_URL=https://api.metalpriceapi.com/v1
SILVER_RATE_BUFFER_PERCENT=2

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shiprocket
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=jewelup-assets
CLOUDFRONT_URL=https://your-cloudfront-distribution.cloudfront.net

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@jewelupbysarita.com

# SMS (MSG91)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=JWLUP
MSG91_TEMPLATE_ID=your-msg91-template-id

# WhatsApp (Gupshup)
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=JewelupBySarita

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
